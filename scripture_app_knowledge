from fastapi import FastAPI, HTTPException #fast api and http error showing shit
from pydantic import BaseModel #mostly used to send and recieve json

app = FastAPI()


class Item(BaseModel): #pydantic shit
    text: str = None
    is_done: bool = False


items = [] #main place to store data


@app.get("/") #main website link
def root():
    return {"Hello": "World"}


@app.post("/items") #if i click on items this runs and send this
def create_item(item: Item):
    items.append(item)
    return items


@app.get("/items", response_model=list[Item]) #send back to user
def list_items(limit: int = 10):
    return items[0:limit]


@app.get("/items/{item_id}", response_model=Item)
def get_item(item_id: int) -> Item:
    if item_id < len(items):
        return items[item_id]
    else:
        raise HTTPException(status_code=404, detail=f"Item {item_id} not found")
        
